# Gateway (LAN IP for phone/emulator — not localhost)
EXPO_PUBLIC_API_URL=http://YOUR_LAN_IP:4000

# Google Maps Platform key (enable: Maps JS, Places API, Places API New, Geocoding)
# Without this, map falls back to Expo native map; search quality is limited.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
